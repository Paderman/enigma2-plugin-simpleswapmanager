msgstr "Неприпустимий розмір"

#, python-format
msgid "Please enter a size between %d and %d MB."
msgstr "Введіть розмір від %d до %d МБ."

msgid "File exists"
msgstr "Файл існує"

#, python-format
msgid "%s already exists and is not a swap file. Please remove it first."
msgstr "%s уже існує і не є файлом підкачки. Спочатку видаліть його."

msgid ""
"The existing swap file is in use and there is not enough free RAM to replace"
" it."
msgstr ""
"Наявний файл підкачки використовується, і вільної ОЗП недостатньо, щоб "
"замінити його."

#, python-format
msgid "%s will be recreated with %s instead of %s."
msgstr "%s буде створено заново: %s замість %s."

#, python-format
msgid ""
"A swap file of %s will be created at\n"
"%s\n"
"and activated at every startup."
msgstr ""
"Файл підкачки розміром %s буде створено в\n"
"%s\n"
"і він вмикатиметься під час кожного запуску."

#, python-format
msgid "The existing swap file (%s) will be replaced."
msgstr "Наявний файл підкачки (%s) буде замінено."

#, python-format
msgid "This takes about %d seconds."
msgstr "Це займе близько %d секунд."

msgid "Create swap file?"
msgstr "Створити файл підкачки?"

msgid "Create swap file"
msgstr "Створити файл підкачки"

msgid "Deactivating old swap file..."
msgstr "Вимкнення старого файлу підкачки..."

