msgid "System default"
msgstr "Predefinito di sistema"

msgid "Plugins and storage menu"
msgstr "Plugin e menu dispositivi"

msgid "Plugin browser only"
msgstr "Solo browser dei plugin"

msgid "Simple Swap Manager"
msgstr "Simple Swap Manager"

msgid "Create and manage swap files"
msgstr "Crea e gestisci file di swap"

msgid "Hard disk"
msgstr "Disco rigido"

msgid "USB storage"
msgstr "Memoria USB"

