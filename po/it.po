"No swap space found.\n"
"Press YELLOW to create a swap file."
msgstr ""
"Nessuno spazio di swap trovato.\n"
"Premi GIALLO per creare un file di swap."

msgid "OK  Options     MENU  Settings     INFO  System info     EXIT  Close"
msgstr ""
"OK  Opzioni     MENU  Impostazioni     INFO  Info sistema     EXIT  Chiudi"

