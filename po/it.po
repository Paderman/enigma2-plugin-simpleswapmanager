msgid ""
"The zram device could not be created. This kernel probably does not support "
"zram."
msgstr ""
"Impossibile creare il dispositivo zram. Probabilmente questo kernel non "
"supporta zram."

msgid "Please wait..."
msgstr "Attendere prego..."

msgid "Could not start command."
msgstr "Impossibile avviare il comando."

#, python-format
msgid "%s of %s written"
msgstr "%s di %s scritti"

#, python-format
