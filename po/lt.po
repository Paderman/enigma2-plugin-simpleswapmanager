msgstr ""
"Mainų sritis nerasta.\n"
"Paspauskite GELTONĄ, kad sukurtumėte mainų failą."

msgid "OK  Options     MENU  Settings     INFO  System info     EXIT  Close"
msgstr ""
"OK  Parinktys     MENU  Nustatymai     INFO  Sistemos info     EXIT  "
"Uždaryti"

