msgstr "Usuń"

msgid "Stop using this swap space now"
msgstr "Przestań teraz używać tej przestrzeni wymiany"

msgid "Start using this swap space now"
msgstr "Zacznij teraz używać tej przestrzeni wymiany"

msgid "Don't activate at startup"
msgstr "Nie aktywuj przy starcie"

msgid "Remove automatic activation"
msgstr "Usuń automatyczną aktywację"

msgid "Activate at startup"
msgstr "Aktywuj przy starcie"

msgid "Set up the compressed RAM swap every time the receiver starts"
msgstr ""
"Konfiguruj skompresowany swap w RAM przy każdym uruchomieniu odbiornika"

msgid "Deactivate zram and give the memory back"
msgstr "Wyłącz zram i oddaj pamięć"

msgid "Change size"
msgstr "Zmień rozmiar"

msgid "Set up zram again with a different size"
msgstr "Skonfiguruj zram ponownie z innym rozmiarem"

msgid "Use this swap file every time the receiver starts"
msgstr "Używaj tego pliku wymiany przy każdym uruchomieniu odbiornika"

msgid "Create the swap file again with a different size"
msgstr "Utwórz plik wymiany ponownie z innym rozmiarem"

msgid "Remove the swap file and free the disk space"
msgstr "Usuń plik wymiany i zwolnij miejsce na dysku"

msgid "Create new swap file"
msgstr "Utwórz nowy plik wymiany"

msgid "What this receiver supports"
msgstr "Co obsługuje ten odbiornik"

#, python-format
msgid "Size: %s"
msgstr "Rozmiar: %s"

#, python-format
