msgid "System default"
msgstr "Domyślne systemowe"

msgid "Plugins and storage menu"
msgstr "Wtyczki i menu nośników"

msgid "Plugin browser only"
msgstr "Tylko przeglądarka wtyczek"

msgid "Simple Swap Manager"
msgstr "Simple Swap Manager"

msgid "Create and manage swap files"
msgstr "Twórz pliki wymiany i zarządzaj nimi"

msgid "Hard disk"
msgstr "Dysk twardy"

msgid "USB storage"
msgstr "Pamięć USB"

msgid "SD card"
msgstr "Karta SD"

