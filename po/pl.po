msgstr "AUTOSTART"

msgid ""
"No swap space found.\n"
"No external drive with a Linux file system (ext4, ...) is mounted - press YELLOW for compressed RAM (zram)."
msgstr ""
"Nie znaleziono przestrzeni wymiany.\n"
"Brak zamontowanego dysku zewnętrznego z systemem plików Linux (ext4, ...) – ŻÓŁTY: skompresowany RAM (zram)."

msgid ""
"No swap space found.\n"
"No external drive with a Linux file system (ext4, ...) is mounted. Connect a USB drive or hard disk and mount it in the image's drive settings."
msgstr ""
"Nie znaleziono przestrzeni wymiany.\n"
"Brak zamontowanego dysku zewnętrznego z systemem plików Linux (ext4, ...). Podłącz dysk USB lub dysk twardy i zamontuj go w ustawieniach dysków obrazu."

#, python-format
msgid "%s RAM"
msgstr "%s RAM"

#, python-format
msgid "ratio %.1f:1"
msgstr "stopień %.1f:1"

