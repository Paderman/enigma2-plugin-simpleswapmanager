msgstr "Simple Swap Manager"

msgid "Create and manage swap files"
msgstr "创建和管理交换文件"

msgid "Hard disk"
msgstr "硬盘"

msgid "USB storage"
msgstr "USB 存储"

msgid "SD card"
msgstr "SD 卡"

