msgstr "取消"

msgid ""
"The zram device could not be created. This kernel probably does not support "
"zram."
msgstr "无法创建 zram 设备。此内核可能不支持 zram。"

msgid "Please wait..."
msgstr "请稍候..."

msgid "Could not start command."
msgstr "无法启动命令。"

#, python-format
msgid "%s of %s written"
msgstr "已写入 %s / %s"

#, python-format
