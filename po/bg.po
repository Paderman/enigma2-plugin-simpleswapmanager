msgstr "Деактивиране на zram и освобождаване на паметта"

msgid "Change size"
msgstr "Промяна на размера"

msgid "Set up zram again with a different size"
msgstr "Ново настройване на zram с друг размер"

msgid "Use this swap file every time the receiver starts"
msgstr "Използване на този суап файл при всяко стартиране на приемника"

msgid "Create the swap file again with a different size"
msgstr "Създаване на суап файла наново с друг размер"

msgid "Remove the swap file and free the disk space"
msgstr "Изтриване на суап файла и освобождаване на дисковото място"

msgid "Create new swap file"
msgstr "Създаване на нов суап файл"

msgid "What this receiver supports"
msgstr "Какво поддържа този приемник"

#, python-format
msgid "Size: %s"
msgstr "Размер: %s"

#, python-format
msgid "Stored: %s, compressed to %s (%s RAM in use)"
msgstr "Съхранени: %s, компресирани до %s (%s RAM в употреба)"

#, python-format
msgid "Algorithm: %s, priority %d"
msgstr "Алгоритъм: %s, приоритет %d"

