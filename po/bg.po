msgstr "Премахни"

msgid "Stop using this swap space now"
msgstr "Спиране на използването на тази суап област"

msgid "Start using this swap space now"
msgstr "Започване на използването на тази суап област"

msgid "Don't activate at startup"
msgstr "Без активиране при стартиране"

msgid "Remove automatic activation"
msgstr "Премахване на автоматичното активиране"

msgid "Activate at startup"
msgstr "Активиране при стартиране"

