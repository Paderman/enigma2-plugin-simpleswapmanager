msgid "System default"
msgstr "Predefinição do sistema"

msgid "Plugins and storage menu"
msgstr "Plugins e menu de armazenamento"

msgid "Plugin browser only"
msgstr "Apenas navegador de plugins"

msgid "Simple Swap Manager"
msgstr "Simple Swap Manager"

msgid "Create and manage swap files"
msgstr "Criar e gerir ficheiros de swap"

msgid "Hard disk"
msgstr "Disco rígido"

msgid "USB storage"
msgstr "Memória USB"

msgid "SD card"
msgstr "Cartão SD"

msgid "Internal flash"
msgstr "Flash interna"

msgid "OK  Select     EXIT  Back"
msgstr "OK  Escolher     EXIT  Voltar"

