msgid "Restart GUI?"
msgstr "Starte GUI på nytt?"

msgid ""
"The plugin is unloaded completely after restarting the GUI. Restart now?"
msgstr ""
"Programtillegget fjernes helt fra minnet først etter omstart av GUI. Starte "
"på nytt nå?"

msgid "Restart now"
msgstr "Start på nytt nå"

msgid "Later"
msgstr "Senere"

msgid "No suitable storage"
msgstr "Ingen egnet lagring"

msgid ""
"No storage device with a Linux file system (ext2/3/4, xfs, ...) was found.\n"
"Swap files cannot be created on FAT, exFAT, NTFS or network drives."
msgstr ""
"Fant ingen lagringsenhet med et Linux-filsystem (ext2/3/4, xfs, ...).\n"
"Vekselfiler kan ikke opprettes på FAT, exFAT, NTFS eller nettverksstasjoner."

msgid "No drive needed  ·  fastest  ·  uses a little CPU"
msgstr "Ingen stasjon trengs  ·  raskest  ·  bruker litt CPU"

msgid "FASTEST"
msgstr "RASKEST"

msgid "Not available on this receiver - press OK for details"
msgstr "Ikke tilgjengelig på denne mottakeren - trykk OK for detaljer"

msgid "NOT SUPPORTED"
msgstr "STØTTES IKKE"

