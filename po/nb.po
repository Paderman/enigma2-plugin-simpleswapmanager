msgid ""
"The zram device could not be created. This kernel probably does not support "
"zram."
msgstr ""
"zram-enheten kunne ikke opprettes. Denne kjernen støtter sannsynligvis ikke "
"zram."

msgid "Please wait..."
msgstr "Vent litt..."

msgid "Could not start command."
msgstr "Kommandoen kunne ikke startes."

