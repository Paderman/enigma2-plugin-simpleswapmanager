msgstr "ZAGON"

msgid ""
"No swap space found.\n"
"No external drive with a Linux file system (ext4, ...) is mounted - press YELLOW for compressed RAM (zram)."
msgstr ""
"Ni najdenega izmenjalnega prostora.\n"
"Ni priklopljenega zunanjega pogona z datotečnim sistemom Linux (ext4, ...) – RUMENA za stisnjen RAM (zram)."

msgid ""
"No swap space found.\n"
"No external drive with a Linux file system (ext4, ...) is mounted. Connect a USB drive or hard disk and mount it in the image's drive settings."
msgstr ""
"Ni najdenega izmenjalnega prostora.\n"
"Ni priklopljenega zunanjega pogona z datotečnim sistemom Linux (ext4, ...). Priključite USB-pogon ali trdi disk in ga priklopite v nastavitvah diskov slike."

#, python-format
msgid "%s RAM"
msgstr "%s RAM"

#, python-format
msgid "ratio %.1f:1"
msgstr "razmerje %.1f:1"

msgid "compressed swap in RAM"
msgstr "stisnjena izmenjava v RAM-u"

