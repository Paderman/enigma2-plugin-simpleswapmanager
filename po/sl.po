msgstr "Prenehaj uporabljati ta izmenjalni prostor"

msgid "Start using this swap space now"
msgstr "Začni uporabljati ta izmenjalni prostor"

msgid "Don't activate at startup"
msgstr "Ne aktiviraj ob zagonu"

msgid "Remove automatic activation"
msgstr "Odstrani samodejno aktivacijo"

msgid "Activate at startup"
msgstr "Aktiviraj ob zagonu"

msgid "Set up the compressed RAM swap every time the receiver starts"
msgstr "Nastavi stisnjeno izmenjavo v RAM-u ob vsakem zagonu sprejemnika"

msgid "Deactivate zram and give the memory back"
msgstr "Izklopi zram in vrni pomnilnik"

msgid "Change size"
msgstr "Spremeni velikost"

msgid "Set up zram again with a different size"
msgstr "Znova nastavi zram z drugo velikostjo"

msgid "Use this swap file every time the receiver starts"
msgstr "Uporabi to izmenjalno datoteko ob vsakem zagonu sprejemnika"

msgid "Create the swap file again with a different size"
msgstr "Znova ustvari izmenjalno datoteko z drugo velikostjo"

msgid "Remove the swap file and free the disk space"
msgstr "Odstrani izmenjalno datoteko in sprosti prostor na disku"

msgid "Create new swap file"
msgstr "Ustvari novo izmenjalno datoteko"

msgid "What this receiver supports"
msgstr "Kaj podpira ta sprejemnik"

#, python-format
msgid "Size: %s"
msgstr "Velikost: %s"

#, python-format
msgid "Stored: %s, compressed to %s (%s RAM in use)"
msgstr "Shranjeno: %s, stisnjeno na %s (%s RAM-a v uporabi)"

#, python-format
msgid "Algorithm: %s, priority %d"
msgstr "Algoritem: %s, prioriteta %d"

msgid "Status: inactive"
msgstr "Stanje: neaktivno"

#, python-format
msgid "Used: %s, priority %d"
msgstr "Zasedeno: %s, prioriteta %d"

