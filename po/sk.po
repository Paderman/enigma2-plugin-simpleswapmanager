"No swap space found.\n"
"Press YELLOW to create a swap file."
msgstr ""
"Nenašiel sa žiadny odkladací priestor.\n"
"Stlačte ŽLTÉ na vytvorenie odkladacieho súboru."

msgid "OK  Options     MENU  Settings     INFO  System info     EXIT  Close"
msgstr ""
"OK  Možnosti     MENU  Nastavenia     INFO  Info o systéme     EXIT  Zavrieť"

