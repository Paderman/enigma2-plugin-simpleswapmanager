msgstr "RAM: %s  ·  pieejams: %s"

msgid "Create swap file  2/2"
msgstr "Mijmaiņas faila izveide  2/2"

#, python-format
msgid ""
"Select the size of the swap file on %s.\n"
"RAM: %s  ·  free space: %s"
msgstr ""
"Izvēlieties mijmaiņas faila izmēru diskā %s.\n"
"RAM: %s  ·  brīvā vieta: %s"

