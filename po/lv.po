msgstr "Lūdzu, ievadiet izmēru no %d līdz %d MB."

msgid "File exists"
msgstr "Fails jau pastāv"

#, python-format
msgid "%s already exists and is not a swap file. Please remove it first."
msgstr "%s jau pastāv un nav mijmaiņas fails. Lūdzu, vispirms to noņemiet."

msgid ""
"The existing swap file is in use and there is not enough free RAM to replace"
" it."
msgstr ""
"Esošais mijmaiņas fails tiek izmantots, un nepietiek brīvas RAM, lai to "
"aizstātu."

#, python-format
msgid "%s will be recreated with %s instead of %s."
msgstr "%s tiks izveidots no jauna ar %s, nevis %s."

#, python-format
msgid ""
"A swap file of %s will be created at\n"
"%s\n"
"and activated at every startup."
msgstr ""
"Mijmaiņas fails ar izmēru %s tiks izveidots\n"
"%s\n"
"un aktivizēts katrā startēšanas reizē."

#, python-format
msgid "The existing swap file (%s) will be replaced."
msgstr "Esošais mijmaiņas fails (%s) tiks aizstāts."

#, python-format
msgid "This takes about %d seconds."
msgstr "Tas aizņem aptuveni %d sekundes."

