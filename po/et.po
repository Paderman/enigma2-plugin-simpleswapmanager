msgstr "Simple Swap Manager"

msgid "Create and manage swap files"
msgstr "Saalefailide loomine ja haldamine"

msgid "Hard disk"
msgstr "Kõvaketas"

msgid "USB storage"
msgstr "USB-andmekandja"

msgid "SD card"
msgstr "SD-kaart"

