msgid ""
"The swappiness is %d. With 10, the receiver swaps out less often and writes "
"less to the card."
msgstr ""
"Swappiness je %d. S hodnotou 10 přijímač odkládá méně často a méně zapisuje "
"na kartu."

msgid "Set swappiness to 10"
msgstr "Nastavit swappiness na 10"

#, python-format
