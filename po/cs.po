msgid ""
"The zram device could not be created. This kernel probably does not support "
"zram."
msgstr ""
"Zařízení zram nelze vytvořit. Toto jádro pravděpodobně zram nepodporuje."

msgid "Please wait..."
msgstr "Čekejte prosím..."

msgid "Could not start command."
msgstr "Příkaz nelze spustit."

#, python-format
