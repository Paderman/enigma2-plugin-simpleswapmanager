msgstr ""
"No se encontró ningún espacio de intercambio.\n"
"Pulse AMARILLO para crear un archivo de intercambio."

msgid "OK  Options     MENU  Settings     INFO  System info     EXIT  Close"
msgstr ""
"OK  Opciones     MENU  Ajustes     INFO  Info sistema     EXIT  Cerrar"

