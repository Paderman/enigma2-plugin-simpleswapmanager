msgstr "Simple Swap Manager"

msgid "Create and manage swap files"
msgstr "Crear y gestionar archivos de intercambio"

msgid "Hard disk"
msgstr "Disco duro"

msgid "USB storage"
msgstr "Memoria USB"

msgid "SD card"
msgstr "Tarjeta SD"

