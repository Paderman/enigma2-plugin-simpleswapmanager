msgid ""
"The zram device could not be created. This kernel probably does not support "
"zram."
msgstr ""
"zram-enheten kunde inte skapas. Den här kärnan stöder troligen inte zram."

msgid "Please wait..."
msgstr "Vänta..."

msgid "Could not start command."
msgstr "Kommandot kunde inte startas."

