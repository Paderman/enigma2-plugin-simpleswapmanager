msgstr "zram är laddat och klart att använda."

msgid "zram is built into the kernel."
msgstr "zram är inbyggt i kärnan."

msgid "zram is available as a kernel module and is loaded when needed."
msgstr "zram finns som kärnmodul och laddas vid behov."

#, python-format
msgid ""
"The kernel of this receiver (%s) was built without zram. A swap file on a "
"drive is the best solution here."
msgstr ""
"Kärnan i den här mottagaren (%s) byggdes utan zram. En växlingsfil på en "
"enhet är den bästa lösningen här."

#, python-format
msgid ""
"The kernel supports zram as a module, but the module is not installed "
"(kernel %s)."
msgstr ""
"Kärnan stöder zram som modul, men modulen är inte installerad (kärna %s)."

#, python-format
msgid "No zram support was found in the kernel (%s)."
msgstr "Inget zram-stöd hittades i kärnan (%s)."

