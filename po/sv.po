msgstr "Den befintliga växlingsfilen (%s) ersätts."

#, python-format
msgid "This takes about %d seconds."
msgstr "Det tar ungefär %d sekunder."

msgid "Create swap file?"
msgstr "Skapa växlingsfil?"

msgid "Create swap file"
msgstr "Skapa växlingsfil"

msgid "Deactivating old swap file..."
msgstr "Inaktiverar gammal växlingsfil..."

