msgid "needs at most about %s RAM when full"
msgstr "använder högst cirka %s RAM när den är full"

msgid "Compressed RAM (zram)  2/2"
msgstr "Komprimerat RAM (zram)  2/2"

#, python-format
msgid ""
"Select the size of the compressed swap (RAM: %s).\n"
"The memory is only used when data is actually swapped out; about half the RAM is a good value."
msgstr ""
"Välj storlek på den komprimerade swappen (RAM: %s).\n"
"Minnet används bara när data faktiskt växlas ut; ungefär halva RAM är ett bra värde."

#, python-format
msgid ""
"A compressed RAM swap of %s will be set up (algorithm: %s) and activated at "
"every startup."
msgstr ""
"En komprimerad RAM-swap på %s sätts upp (algoritm: %s) och aktiveras vid "
"varje start."

msgid "kernel default"
msgstr "kärnans standard"

msgid "It is used before swap files on drives."
msgstr "Den används före växlingsfiler på enheter."

#, python-format
msgid "The current zram swap (%s) will be replaced."
msgstr "Den nuvarande zram-swappen (%s) ersätts."

