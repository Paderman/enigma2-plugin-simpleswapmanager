msgstr "Aktiviraj swap"

msgid "Setting up compressed RAM swap..."
msgstr "Podešavanje sažetog swapa u RAM-u..."

msgid "Swap activated"
msgstr "Swap aktiviran"

msgid "Deactivate swap"
msgstr "Deaktiviraj swap"

msgid "Swap deactivated"
msgstr "Swap deaktiviran"

msgid "The file is not a valid swap file."
msgstr "Datoteka nije ispravna swap datoteka."

msgid "Activating swap..."
msgstr "Aktiviranje swapa..."

