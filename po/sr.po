msgstr "Prestani da koristiš ovaj swap prostor"

msgid "Start using this swap space now"
msgstr "Počni da koristiš ovaj swap prostor"

msgid "Don't activate at startup"
msgstr "Ne aktiviraj pri pokretanju"

msgid "Remove automatic activation"
msgstr "Ukloni automatsku aktivaciju"

msgid "Activate at startup"
msgstr "Aktiviraj pri pokretanju"

msgid "Set up the compressed RAM swap every time the receiver starts"
msgstr "Podesi sažeti swap u RAM-u pri svakom pokretanju prijemnika"

msgid "Deactivate zram and give the memory back"
msgstr "Deaktiviraj zram i vrati memoriju"

msgid "Change size"
msgstr "Promeni veličinu"

msgid "Set up zram again with a different size"
msgstr "Ponovo podesi zram sa drugom veličinom"

