msgid "System default"
msgstr "Podrazumevana vrednost sistema"

msgid "Plugins and storage menu"
msgstr "Dodaci i meni uređaja za skladištenje"

msgid "Plugin browser only"
msgstr "Samo pregledač dodataka"

msgid "Simple Swap Manager"
msgstr "Simple Swap Manager"

msgid "Create and manage swap files"
msgstr "Pravljenje i upravljanje swap datotekama"

msgid "Hard disk"
msgstr "Hard disk"

msgid "USB storage"
msgstr "USB skladište"

msgid "SD card"
msgstr "SD kartica"

msgid "Internal flash"
msgstr "Interni fleš"

msgid "OK  Select     EXIT  Back"
msgstr "OK  Izbor     EXIT  Nazad"

