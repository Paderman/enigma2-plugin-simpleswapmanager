msgstr "Koristi ovu swap datoteku pri svakom pokretanju prijemnika"

msgid "Create the swap file again with a different size"
msgstr "Ponovo napravi swap datoteku sa drugom veličinom"

msgid "Remove the swap file and free the disk space"
msgstr "Ukloni swap datoteku i oslobodi prostor na disku"

msgid "Create new swap file"
msgstr "Napravi novu swap datoteku"

msgid "What this receiver supports"
msgstr "Šta ovaj prijemnik podržava"

#, python-format
msgid "Size: %s"
msgstr "Veličina: %s"

#, python-format
msgid "Stored: %s, compressed to %s (%s RAM in use)"
msgstr "Smešteno: %s, sažeto na %s (%s RAM-a u upotrebi)"

#, python-format
msgid "Algorithm: %s, priority %d"
msgstr "Algoritam: %s, prioritet %d"

msgid "Status: inactive"
msgstr "Stanje: neaktivno"

#, python-format
msgid "Used: %s, priority %d"
msgstr "Zauzeto: %s, prioritet %d"

msgid "Startup activation disabled"
msgstr "Aktivacija pri pokretanju isključena"

msgid "Activated at every startup"
msgstr "Aktivira se pri svakom pokretanju"

