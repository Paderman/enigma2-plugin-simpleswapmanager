msgstr "POKRETANJE"

msgid ""
"No swap space found.\n"
"No external drive with a Linux file system (ext4, ...) is mounted - press YELLOW for compressed RAM (zram)."
msgstr ""
"Nije pronađen swap prostor.\n"
"Nije montiran spoljni disk sa Linux sistemom datoteka (ext4, ...) – ŽUTO za kompresovani RAM (zram)."

msgid ""
"No swap space found.\n"
"No external drive with a Linux file system (ext4, ...) is mounted. Connect a USB drive or hard disk and mount it in the image's drive settings."
msgstr ""
"Nije pronađen swap prostor.\n"
"Nije montiran spoljni disk sa Linux sistemom datoteka (ext4, ...). Povežite USB disk ili hard disk i montirajte ga u podešavanjima diskova imidža."

#, python-format
msgid "%s RAM"
msgstr "%s RAM"

#, python-format
msgid "ratio %.1f:1"
msgstr "odnos %.1f:1"

msgid "compressed swap in RAM"
msgstr "sažeti swap u RAM-u"

