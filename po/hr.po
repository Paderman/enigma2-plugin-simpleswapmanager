msgstr "Swap"

msgid "Total"
msgstr "Ukupno"

msgid "CPU"
msgstr "CPU"

msgid "Swap spaces"
msgstr "Swap prostori"

msgid ""
"No swap space found.\n"
"Press YELLOW to create a swap file."
msgstr ""
"Nije pronađen swap prostor.\n"
"Pritisnite ŽUTU tipku za stvaranje swap datoteke."

