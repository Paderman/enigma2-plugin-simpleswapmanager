msgstr "มีไฟล์อยู่แล้ว"

#, python-format
msgid "%s already exists and is not a swap file. Please remove it first."
msgstr "%s มีอยู่แล้วและไม่ใช่ไฟล์สว็อป โปรดลบออกก่อน"

msgid ""
"The existing swap file is in use and there is not enough free RAM to replace"
" it."
msgstr "ไฟล์สว็อปที่มีอยู่กำลังใช้งาน และ RAM ว่างไม่พอที่จะแทนที่"

#, python-format
msgid "%s will be recreated with %s instead of %s."
msgstr "%s จะถูกสร้างใหม่เป็น %s แทน %s"

#, python-format
msgid ""
"A swap file of %s will be created at\n"
"%s\n"
"and activated at every startup."
msgstr ""
"จะสร้างไฟล์สว็อปขนาด %s ที่\n"
"%s\n"
"และเปิดใช้งานทุกครั้งที่เริ่มระบบ"

#, python-format
msgid "The existing swap file (%s) will be replaced."
msgstr "ไฟล์สว็อปที่มีอยู่ (%s) จะถูกแทนที่"

