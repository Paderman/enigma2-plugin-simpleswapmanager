"Select the size of the swap file on %s.\n"
"RAM: %s  ·  free space: %s"
msgstr ""
"เลือกขนาดของไฟล์สว็อปบน %s\n"
"RAM: %s  ·  พื้นที่ว่าง: %s"

#, python-format
msgid "Swap file size in MB (%d-%d)"
msgstr "ขนาดไฟล์สว็อปเป็น MB (%d-%d)"

msgid "Invalid size"
msgstr "ขนาดไม่ถูกต้อง"

#, python-format
msgid "Please enter a size between %d and %d MB."
msgstr "โปรดป้อนขนาดระหว่าง %d ถึง %d MB"

