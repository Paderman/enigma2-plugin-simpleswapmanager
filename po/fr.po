msgstr "RAM : %s  ·  disponible : %s"

msgid "Create swap file  2/2"
msgstr "Créer un fichier d'échange  2/2"

#, python-format
msgid ""
"Select the size of the swap file on %s.\n"
"RAM: %s  ·  free space: %s"
msgstr ""
"Choisissez la taille du fichier d'échange sur %s.\n"
"RAM : %s  ·  espace libre : %s"

#, python-format
msgid "Swap file size in MB (%d-%d)"
msgstr "Taille du fichier d'échange en Mo (%d-%d)"

msgid "Invalid size"
msgstr "Taille invalide"

#, python-format
