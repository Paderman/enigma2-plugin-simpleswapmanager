msgstr "Veuillez entrer une taille entre %d et %d Mo."

msgid "File exists"
msgstr "Le fichier existe"

#, python-format
msgid "%s already exists and is not a swap file. Please remove it first."
msgstr ""
"%s existe déjà et n'est pas un fichier d'échange. Veuillez d'abord le "
"supprimer."

msgid ""
"The existing swap file is in use and there is not enough free RAM to replace"
" it."
msgstr ""
"Le fichier d'échange existant est utilisé et il n'y a pas assez de RAM libre"
" pour le remplacer."

#, python-format
msgid "%s will be recreated with %s instead of %s."
msgstr "%s sera recréé avec %s au lieu de %s."

#, python-format
msgid ""
"A swap file of %s will be created at\n"
"%s\n"
"and activated at every startup."
msgstr ""
"Un fichier d'échange de %s sera créé dans\n"
"%s\n"
"et activé à chaque démarrage."

#, python-format
msgid "The existing swap file (%s) will be replaced."
msgstr "Le fichier d'échange existant (%s) sera remplacé."

#, python-format
msgid "This takes about %d seconds."
msgstr "Cela prend environ %d secondes."

msgid "Create swap file?"
msgstr "Créer le fichier d'échange ?"

msgid "Create swap file"
msgstr "Créer le fichier d'échange"

msgid "Deactivating old swap file..."
msgstr "Désactivation de l'ancien fichier d'échange..."

