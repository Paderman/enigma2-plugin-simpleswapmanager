msgid ""
"The zram device could not be created. This kernel probably does not support "
"zram."
msgstr ""
"Le périphérique zram n'a pas pu être créé. Ce noyau ne prend probablement "
"pas en charge zram."

msgid "Please wait..."
msgstr "Veuillez patienter..."

msgid "Could not start command."
msgstr "Impossible de lancer la commande."

#, python-format
msgid "%s of %s written"
msgstr "%s sur %s écrits"

#, python-format
msgid "Error code %d"
msgstr "Code d'erreur %d"

