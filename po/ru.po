msgid "Swappiness: %d"
msgstr "Swappiness: %d"

#, python-format
msgid "Startup: %s"
msgstr "Запуск: %s"

msgid "Startup: off"
msgstr "Запуск: выкл."

#, python-format
msgid "zram: %s"
msgstr "zram: %s"

#, python-format
msgid "Swap in: %s/s, out: %s/s"
msgstr "Подкачка: чтение %s/s, запись %s/s"

#, python-format
msgid "Written since boot: %s"
msgstr "Записано с запуска: %s"

msgid "Swap partition"
msgstr "Раздел подкачки"

msgid "Swap file"
msgstr "Файл подкачки"

#, python-format
msgid "%s used"
msgstr "занято %s"

msgid "ACTIVE"
msgstr "АКТИВНО"

msgid "INACTIVE"
msgstr "НЕАКТИВНО"

msgid "STARTUP"
msgstr "АВТОЗАПУСК"

msgid ""
"No swap space found.\n"
"No external drive with a Linux file system (ext4, ...) is mounted - press YELLOW for compressed RAM (zram)."
msgstr ""
"Области подкачки не найдены.\n"
"Нет внешнего накопителя с файловой системой Linux (ext4, ...) – ЖЁЛТАЯ: сжатая RAM (zram)."

msgid ""
"No swap space found.\n"
"No external drive with a Linux file system (ext4, ...) is mounted. Connect a USB drive or hard disk and mount it in the image's drive settings."
msgstr ""
"Области подкачки не найдены.\n"
"Не подключён внешний накопитель с файловой системой Linux (ext4, ...). Подключите USB-накопитель или жёсткий диск и смонтируйте его в настройках дисков образа."

#, python-format
msgid "%s RAM"
msgstr "%s ОЗУ"

#, python-format
msgid "ratio %.1f:1"
msgstr "сжатие %.1f:1"

msgid "compressed swap in RAM"
msgstr "сжатая подкачка в ОЗУ"

msgid "Deactivate"
msgstr "Отключить"

msgid "Activate"
msgstr "Включить"

msgid "Delete"
msgstr "Удалить"

msgid "Remove"
msgstr "Убрать"

msgid "Stop using this swap space now"
msgstr "Прекратить использовать эту область подкачки"

msgid "Start using this swap space now"
msgstr "Начать использовать эту область подкачки"

msgid "Don't activate at startup"
msgstr "Не включать при запуске"

msgid "Remove automatic activation"
msgstr "Убрать автоматическое включение"

msgid "Activate at startup"
msgstr "Включать при запуске"

msgid "Set up the compressed RAM swap every time the receiver starts"
msgstr "Настраивать сжатую подкачку в ОЗУ при каждом запуске ресивера"

msgid "Deactivate zram and give the memory back"
msgstr "Отключить zram и вернуть память"

msgid "Change size"
msgstr "Изменить размер"

msgid "Set up zram again with a different size"
msgstr "Настроить zram заново с другим размером"

msgid "Use this swap file every time the receiver starts"
msgstr "Использовать этот файл подкачки при каждом запуске ресивера"

msgid "Create the swap file again with a different size"
msgstr "Создать файл подкачки заново с другим размером"

msgid "Remove the swap file and free the disk space"
msgstr "Удалить файл подкачки и освободить место на диске"

msgid "Create new swap file"
msgstr "Создать новый файл подкачки"

msgid "What this receiver supports"
msgstr "Что поддерживает этот ресивер"

#, python-format
msgid "Size: %s"
msgstr "Размер: %s"

#, python-format
msgid "Stored: %s, compressed to %s (%s RAM in use)"
msgstr "Хранится: %s, сжато до %s (%s ОЗУ занято)"

#, python-format
msgid "Algorithm: %s, priority %d"
msgstr "Алгоритм: %s, приоритет %d"

msgid "Status: inactive"
msgstr "Состояние: неактивно"

#, python-format
msgid "Used: %s, priority %d"
msgstr "Занято: %s, приоритет %d"

msgid "Startup activation disabled"
msgstr "Включение при запуске отключено"

msgid "Activated at every startup"
msgstr "Включается при каждом запуске"

msgid "Activate swap"
msgstr "Включить подкачку"

msgid "Setting up compressed RAM swap..."
msgstr "Настройка сжатой подкачки в ОЗУ..."

msgid "Swap activated"
msgstr "Подкачка включена"

msgid "Deactivate swap"
msgstr "Отключить подкачку"

msgid "Swap deactivated"
msgstr "Подкачка отключена"

msgid "The file is not a valid swap file."
msgstr "Файл не является допустимым файлом подкачки."

msgid "Activating swap..."
msgstr "Включение подкачки..."

msgid "Delete swap file"
msgstr "Удалить файл подкачки"

msgid "Swap file deleted"
msgstr "Файл подкачки удалён"

msgid "Delete swap file?"
msgstr "Удалить файл подкачки?"

#, python-format
msgid "%s (%s) will be deactivated and deleted."
msgstr "%s (%s) будет отключён и удалён."

msgid "Restart GUI?"
msgstr "Перезапустить GUI?"

msgid ""
"The plugin is unloaded completely after restarting the GUI. Restart now?"
msgstr ""
"Плагин полностью выгружается только после перезапуска GUI. Перезапустить "
"сейчас?"

msgid "Restart now"
msgstr "Перезапустить сейчас"

msgid "Later"
msgstr "Позже"

msgid "No suitable storage"
msgstr "Нет подходящего накопителя"

msgid ""
"No storage device with a Linux file system (ext2/3/4, xfs, ...) was found.\n"
"Swap files cannot be created on FAT, exFAT, NTFS or network drives."
msgstr ""
"Не найден накопитель с файловой системой Linux (ext2/3/4, xfs, ...).\n"
"Файлы подкачки нельзя создавать на FAT, exFAT, NTFS и сетевых дисках."

msgid "No drive needed  ·  fastest  ·  uses a little CPU"
msgstr "Без накопителя  ·  быстрее всего  ·  немного нагружает ЦП"

msgid "FASTEST"
msgstr "БЫСТРЕЕ ВСЕГО"

msgid "Not available on this receiver - press OK for details"
msgstr "Недоступно на этом ресивере — OK: подробности"

msgid "NOT SUPPORTED"
msgstr "НЕ ПОДДЕРЖ."

#, python-format
msgid "%s free"
msgstr "свободно %s"

msgid "NOT RECOMMENDED"
msgstr "НЕ РЕКОМЕНДУЕТСЯ"

msgid "NOT IDEAL"
msgstr "НЕ ИДЕАЛЬНО"

msgid "RECOMMENDED"
msgstr "РЕКОМЕНДУЕТСЯ"

msgid "FULL"
msgstr "ЗАПОЛНЕН"

msgid ""
"Where should the swap file be stored?\n"
"A hard disk or USB drive is best; internal flash wears out faster."
msgstr ""
"Где сохранить файл подкачки?\n"
"Лучше всего жёсткий диск или USB-накопитель; внутренняя флеш-память изнашивается быстрее."

msgid ""
"Where should the swap space be created?\n"
"zram compresses memory inside the RAM; it can be combined with a swap file on a drive."
msgstr ""
"Где создать область подкачки?\n"
"zram сжимает память внутри ОЗУ; его можно сочетать с файлом подкачки на накопителе."

msgid "Create swap file  1/2"
msgstr "Создание файла подкачки  1/2"

msgid "zram not supported"
msgstr "zram не поддерживается"

msgid "Not enough space"
msgstr "Недостаточно места"

#, python-format
msgid "There is not enough free space on %s."
msgstr "На %s недостаточно свободного места."

msgid "Use internal flash?"
msgstr "Использовать внутреннюю флеш-память?"

msgid ""
"Swapping to the internal flash memory causes many write cycles and may "
"shorten its life. A USB drive or hard disk is recommended."
msgstr ""
"Подкачка на внутреннюю флеш-память вызывает много циклов записи и может "
"сократить срок её службы. Рекомендуется USB-накопитель или жёсткий диск."

msgid ""
"The internal flash is soldered in and cannot be replaced like an SD card or "
"USB drive - if it wears out, the receiver itself is affected."
msgstr ""
"Встроенная флеш-память впаяна и не заменяется, как SD-карта или USB-"
"накопитель, – если она износится, пострадает сам ресивер."

msgid "Use internal flash anyway"
msgstr "Всё равно использовать флеш-память"

msgid "Use SD card?"
msgstr "Использовать SD-карту?"

msgid ""
"Swapping writes to the card again and again, so SD cards wear out faster. A USB drive or hard disk is recommended.\n"
"If you use the card: a low swappiness (10-20) keeps the writes to a minimum."
msgstr ""
"Подкачка снова и снова записывает данные на карту, поэтому SD-карты изнашиваются быстрее. Рекомендуется USB-накопитель или жёсткий диск.\n"
"Если используете карту: низкое значение swappiness (10-20) сводит запись к минимуму."

msgid "Use SD card anyway"
msgstr "Всё равно использовать SD-карту"

msgid "Custom size..."
msgstr "Свой размер..."

#, python-format
msgid "Enter a size between %d and %d MB"
msgstr "Введите размер от %d до %d МБ"

#, python-format
msgid "New size for %s (currently %s):"
msgstr "Новый размер для %s (сейчас %s):"

#, python-format
msgid "RAM: %s  ·  available: %s"
msgstr "RAM: %s  ·  доступно: %s"

msgid "Create swap file  2/2"
msgstr "Создание файла подкачки  2/2"

#, python-format
msgid ""
"Select the size of the swap file on %s.\n"
"RAM: %s  ·  free space: %s"
msgstr ""
"Выберите размер файла подкачки на %s.\n"
"ОЗУ: %s  ·  свободно: %s"

#, python-format
msgid "Swap file size in MB (%d-%d)"
msgstr "Размер файла подкачки в МБ (%d-%d)"

msgid "Invalid size"
msgstr "Недопустимый размер"

#, python-format
msgid "Please enter a size between %d and %d MB."
msgstr "Введите размер от %d до %d МБ."

msgid "File exists"
msgstr "Файл существует"

#, python-format
msgid "%s already exists and is not a swap file. Please remove it first."
msgstr "%s уже существует и не является файлом подкачки. Сначала удалите его."

msgid ""
"The existing swap file is in use and there is not enough free RAM to replace"
" it."
msgstr ""
"Существующий файл подкачки используется, и свободной ОЗУ недостаточно, чтобы"
" заменить его."

#, python-format
msgid "%s will be recreated with %s instead of %s."
msgstr "%s будет создан заново: %s вместо %s."

#, python-format
msgid ""
"A swap file of %s will be created at\n"
"%s\n"
